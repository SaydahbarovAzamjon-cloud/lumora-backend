# Lumora backend — local development
# Copy to `.env` and adjust. Never commit real secrets.

NODE_ENV=development
PORT=3000

# MongoDB (NestJS is the only writer for product data)
MONGODB_URI=mongodb://127.0.0.1:27017/lumora

# JWT (required for auth)
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=1d

# Google OAuth — required for loginWithGoogle
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMTP — OTP delivery (signup + password recovery)
# If unset in development, codes are logged to the server console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Lumora <noreply@lumora.app>

# Admin Telegram notifications (password reset events)
# If unset, notifications are logged to the server console.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# FastAPI AI service (NestJS → AI only; never expose to browsers)
# Use AI_MOCK=true for local analyzeFace without lumora-ai running.
AI_BASE_URL=http://127.0.0.1:8000
# AI_API_KEY=          # required when NODE_ENV=production (ADR-019)
# AI_TIMEOUT_MS=15000
# AI_MOCK=true
