# Lumora API (NestJS)
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/lumora

# JWT (ADR-010). Refresh strategy / exact TTLs still open (OPEN-014).
# MVP ships access-token-only; refreshToken is omitted until OPEN-014 closes.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=7d

# Google OAuth (ADR-009) — verify ID tokens from the frontend
GOOGLE_CLIENT_ID=

# CORS — comma-separated origins for the Next.js app (empty = reflect request origin in dev)
CORS_ORIGINS=http://localhost:3001
