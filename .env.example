# Lumora backend — local development
# Copy to `.env` and adjust. Never commit real secrets.

NODE_ENV=development
PORT=3000

# MongoDB (NestJS is the only writer for product data)
MONGODB_URI=mongodb://127.0.0.1:27017/lumora

# JWT — required when auth module (T-101) is implemented
# JWT_SECRET=change-me-in-development
# JWT_EXPIRES_IN=1d

# FastAPI AI service — required when AI client (T-104) is implemented
# AI_BASE_URL=http://127.0.0.1:8000
# AI_API_KEY=

# Google OAuth — required for Google login (T-101)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
